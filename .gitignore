# artefatos de compilacao (reproduzem via `make`)
mpas2intermediate/obj/
mpas2intermediate/extract_fields
mpas2intermediate/pack_intermediate
mpas2intermediate/test_interp
mpas2intermediate/hinterp_native
mpas2intermediate/gen_vertical_grid
mpas2intermediate/gen_init_native
mpas2intermediate/gen_lbc_native

# doc_voronoi/: versiona relatorio_tecnico/, prototipo_scatter/ e conteudo.txt
# (codigo/tex/notas proprios), mas nao os PDFs de artigos de referencia soltos
# na raiz (grandes, nao sao produzidos por este projeto) nem metadados de
# download do navegador.
doc_voronoi/*.pdf
doc_voronoi/*:Zone.Identifier

# artefatos de compilacao do LaTeX (reproduzem via `make` em relatorio_tecnico/)
doc_voronoi/relatorio_tecnico/*.aux
doc_voronoi/relatorio_tecnico/capitulos/*.aux
doc_voronoi/relatorio_tecnico/*.bbl
doc_voronoi/relatorio_tecnico/*.bcf
doc_voronoi/relatorio_tecnico/*.blg
doc_voronoi/relatorio_tecnico/*.out
doc_voronoi/relatorio_tecnico/*.run.xml
doc_voronoi/relatorio_tecnico/*.toc
doc_voronoi/relatorio_tecnico/*.lof
doc_voronoi/relatorio_tecnico/*.lot

convert_mpas/convert_mpas
convert_mpas/src/*.o
convert_mpas/src/*.mod

# saidas de teste (grandes, regeneraveis)
MPAS-Limited-Area/*.nc
MPAS-Limited-Area/*.graph.info
*.grib2
*.grb

# metadados do Windows/WSL
*:Zone.Identifier

# saidas de rodada (nao versionar dados/resultados)
/tmp/
*.log
