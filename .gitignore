# artefatos de compilacao (reproduzem via `make`)
core/src/obj/
core/src/extract_fields
core/src/pack_intermediate
core/src/test_interp
core/src/hinterp_native
core/src/gen_vertical_grid
core/src/gen_init_native
core/src/gen_lbc_native

# doc_voronoi/: versiona prototipo_scatter/ e conteudo.txt (codigo/notas
# proprios), mas nao os PDFs de artigos de referencia soltos na raiz (grandes,
# nao sao produzidos por este projeto) nem metadados de download do navegador.
doc_voronoi/*.pdf
doc_voronoi/*:Zone.Identifier

# relatorio_tecnico/: mantido SO' LOCAL a pedido do usuario (2026-09-09) --
# nao versionar (nem os .tex/.bib/Makefile fonte, nem o PDF gerado).
doc_voronoi/relatorio_tecnico/

core/vendor/convert_mpas/convert_mpas
core/vendor/convert_mpas/src/*.o
core/vendor/convert_mpas/src/*.mod

# saidas de teste (grandes, regeneraveis)
core/vendor/limited_area/*.nc
core/vendor/limited_area/*.graph.info
*.grib2
*.grb

# metadados do Windows/WSL
*:Zone.Identifier

# saidas de rodada (nao versionar dados/resultados)
/tmp/
*.log

__pycache__/
